{
  "_comment": [
    "Key-queue mismatch + stale alerts (Grafana unified alerting).",
    "mismatch: fires when keeper_keyqueue_mismatch == 1 on any pool key:",
    "  zenCLI echo and opencode-direct disagreed on the same key+round",
    "  (the user's custom trigger \u2014 gate/key/tooling change signal).",
    "stale: fires when the pool ledger is older than 3h (heartbeat missed",
    "  3 hourly firings) \u2014 the queue-stale safety.",
    "Shape mirrors keeper-divergent-alert.json (proven): group interval is",
    "  integer seconds, range -> reduce(last) -> threshold(gt). for 0s on",
    "  mismatch (rare + actionable); for 5m on stale (deploy gaps flap).",
    "Both notify HonzaTraderBot (telegram, owner-confirmed).",
    "stale v2 (2026-09-20): measures max zen probe checked_at (>2h), not",
    "ledger generated_at - render-only refreshes cannot silence it."
  ],
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "keeper-keyqueue",
      "folder": "keeper",
      "interval": 60,
      "rules": [
        {
          "uid": "keeper-keyqueue-mismatch",
          "title": "Key-queue zenCLI/opencode mismatch",
          "condition": "C",
          "for": "0s",
          "keep_firing_for": "0s",
          "noDataState": "NoData",
          "execErrState": "Error",
          "annotations": {
            "summary": "zenCLI vs opencode verdict split on {{ $labels.key }}",
            "description": "The two legs disagreed on the same key+round \u2014 gate, key, or tooling change. Queue: https://keeper.pkubelka.cz/"
          },
          "labels": {
            "severity": "page",
            "service": "keeper"
          },
          "data": [
            {
              "refId": "A",
              "queryType": "range",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "grafanacloud-prom",
              "model": {
                "expr": "max by (key) (keeper_keyqueue_mismatch)",
                "intervalMs": 60000,
                "maxDataPoints": 43200,
                "queryType": "range",
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "queryType": "",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "expression": "A",
                "intervalMs": 60000,
                "maxDataPoints": 43200,
                "reducer": "last",
                "refId": "B",
                "type": "reduce"
              }
            },
            {
              "refId": "C",
              "queryType": "",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "conditions": [
                  {
                    "evaluator": {
                      "params": [
                        0
                      ],
                      "type": "gt"
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": []
                    },
                    "reducer": {
                      "type": "last"
                    },
                    "type": "query"
                  }
                ],
                "expression": "B",
                "intervalMs": 60000,
                "maxDataPoints": 43200,
                "refId": "C",
                "type": "threshold"
              }
            }
          ],
          "notification_settings": {
            "receiver": "HonzaTraderBot"
          }
        },
        {
          "uid": "keeper-queue-stale",
          "title": "Key-queue heartbeat stalled (>2h without a zen round)",
          "condition": "C",
          "for": "5m",
          "keep_firing_for": "0s",
          "noDataState": "NoData",
          "execErrState": "Error",
          "annotations": {
            "summary": "No zen key round in 2h (last heartbeat {{ $value }}s ago)",
            "description": "Measures actual testing progress (max zen probe time), not ledger render age - re-rendering cannot game it. Queue: https://keeper.pkubelka.cz/"
          },
          "labels": {
            "severity": "page",
            "service": "keeper"
          },
          "data": [
            {
              "refId": "A",
              "queryType": "range",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "grafanacloud-prom",
              "model": {
                "expr": "time() - max(keeper_probe_checked_at_seconds{connection=~\"zen/.*\"})",
                "intervalMs": 60000,
                "maxDataPoints": 43200,
                "queryType": "range",
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "queryType": "",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "expression": "A",
                "intervalMs": 60000,
                "maxDataPoints": 43200,
                "reducer": "last",
                "refId": "B",
                "type": "reduce"
              }
            },
            {
              "refId": "C",
              "queryType": "",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "conditions": [
                  {
                    "evaluator": {
                      "params": [
                        7200
                      ],
                      "type": "gt"
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": []
                    },
                    "reducer": {
                      "type": "last"
                    },
                    "type": "query"
                  }
                ],
                "expression": "B",
                "intervalMs": 60000,
                "maxDataPoints": 43200,
                "refId": "C",
                "type": "threshold"
              }
            }
          ],
          "notification_settings": {
            "receiver": "HonzaTraderBot"
          }
        }
      ]
    }
  ]
}
